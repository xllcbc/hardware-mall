  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Token认证"
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "message": { "type": "string", "example": "success" },
          "data": { "type": "object" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string" },
              "userInfo": { "$ref": "#/components/schemas/User" }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "openid": { "type": "string" },
          "unionid": { "type": "string" },
          "nickname": { "type": "string" },
          "avatarUrl": { "type": "string" },
          "phone": { "type": "string" },
          "province": { "type": "string" },
          "city": { "type": "string" },
          "role": { "type": "integer", "description": "1-普通用户，2-管理员" },
          "status": { "type": "integer", "description": "1-正常，0-禁用" },
          "lastLoginTime": { "type": "string" },
          "lastLoginIp": { "type": "string" },
          "createTime": { "type": "string" }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "categoryId": { "type": "integer" },
          "name": { "type": "string" },
          "subtitle": { "type": "string" },
          "spec": { "type": "string" },
          "description": { "type": "string" },
          "images": {
            "type": "array",
            "items": { "type": "string" }
          },
          "price": { "type": "integer", "description": "单价，单位：分" },
          "originalPrice": { "type": "integer", "description": "原价，单位：分" },
          "stock": { "type": "integer" },
          "salesCount": { "type": "integer" },
          "status": { "type": "integer", "description": "1-上架，0-下架" },
          "isRecommend": { "type": "integer", "description": "1-推荐，0-非推荐" },
          "categoryName": { "type": "string" },
          "createTime": { "type": "string" }
        }
      },
      "ProductCreate": {
        "type": "object",
        "properties": {
          "categoryId": { "type": "integer" },
          "name": { "type": "string" },
          "subtitle": { "type": "string" },
          "spec": { "type": "string" },
          "description": { "type": "string" },
          "images": {
            "type": "array",
            "items": { "type": "string" }
          },
          "price": { "type": "integer" },
          "originalPrice": { "type": "integer" },
          "stock": { "type": "integer" },
          "status": { "type": "integer" },
          "isRecommend": { "type": "integer" }
        },
        "required": ["categoryId", "name", "price", "stock"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "parentId": { "type": "integer" },
          "name": { "type": "string" },
          "icon": { "type": "string" },
          "sortOrder": { "type": "integer" },
          "status": { "type": "integer" },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "sortOrder": { "type": "integer" }
              }
            }
          }
        }
      },
      "Logistics": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "code": { "type": "string" },
          "description": { "type": "string" },
          "contact": { "type": "string" },
          "phones": {
            "type": "array",
            "items": { "type": "string" }
          },
          "city": { "type": "string" },
          "address": { "type": "string" },
          "sortOrder": { "type": "integer" },
          "status": { "type": "integer" }
        }
      },
      "LogisticsCreate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "code": { "type": "string" },
          "description": { "type": "string" },
          "contact": { "type": "string" },
          "phones": {
            "type": "array",
            "items": { "type": "string" }
          },
          "city": { "type": "string" },
          "sortOrder": { "type": "integer" },
          "status": { "type": "integer" }
        },
        "required": ["name", "code"]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "orderNo": { "type": "string" },
          "userId": { "type": "integer" },
          "receiverName": { "type": "string" },
          "receiverPhone": { "type": "string" },
          "receiverAddress": { "type": "string" },
          "totalAmount": { "type": "integer", "description": "订单总金额，单位：分" },
          "freightAmount": { "type": "integer", "description": "运费，单位：分" },
          "payAmount": { "type": "integer", "description": "实付金额，单位：分" },
          "status": { "type": "integer" },
          "statusText": { "type": "string" },
          "logisticsName": { "type": "string" },
          "logisticsNo": { "type": "string" },
          "payTime": { "type": "string" },
          "shipTime": { "type": "string" },
          "receiveTime": { "type": "string" },
          "cancelTime": { "type": "string" },
          "cancelReason": { "type": "string" },
          "buyerRemark": { "type": "string" },
          "createTime": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OrderItem" }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "orderId": { "type": "integer" },
          "productId": { "type": "integer" },
          "productName": { "type": "string" },
          "productSpec": { "type": "string" },
          "productImage": { "type": "string" },
          "price": { "type": "integer" },
          "quantity": { "type": "integer" },
          "subtotal": { "type": "integer" }
        }
      },
      "OrderCreate": {
        "type": "object",
        "properties": {
          "addressId": { "type": "integer" },
          "logisticsId": { "type": "integer" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": { "type": "integer" },
                "quantity": { "type": "integer" }
              }
            }
          },
          "buyerRemark": { "type": "string" }
        },
        "required": ["addressId", "logisticsId", "items"]
      },
      "Address": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "consignee": { "type": "string" },
          "phone": { "type": "string" },
          "province": { "type": "string" },
          "city": { "type": "string" },
          "district": { "type": "string" },
          "detail": { "type": "string" },
          "postalCode": { "type": "string" },
          "isDefault": { "type": "integer", "description": "1-默认，0-非默认" }
        }
      },
      "AddressCreate": {
        "type": "object",
        "properties": {
          "consignee": { "type": "string" },
          "phone": { "type": "string" },
          "province": { "type": "string" },
          "city": { "type": "string" },
          "district": { "type": "string" },
          "detail": { "type": "string" },
          "postalCode": { "type": "string" },
          "isDefault": { "type": "integer" }
        },
        "required": ["consignee", "phone", "province", "city", "district", "detail"]
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "productId": { "type": "integer" },
          "quantity": { "type": "integer" },
          "product": { "$ref": "#/components/schemas/Product" }
        }
      },
      "PageResult": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "list": {
                "type": "array",
                "items": {}
              },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}

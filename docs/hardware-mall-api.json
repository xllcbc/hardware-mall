  "paths": {
    "/api/admin/login": {
      "post": {
        "tags": ["管理端-认证模块"],
        "summary": "管理员登录",
        "description": "通过用户名密码登录，获取管理员Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "管理员用户名"
                  },
                  "password": {
                    "type": "string",
                    "description": "管理员密码"
                  }
                },
                "required": ["username", "password"]
              },
              "example": {
                "username": "admin",
                "password": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/refresh": {
      "post": {
        "tags": ["管理端-认证模块"],
        "summary": "刷新管理员Token",
        "security": [{ "BearerAuth": [] }],

{
  "openapi": "3.0.3",
  "info": {
    "title": "五金商城系统API",
    "version": "1.0.0",
    "description": "五金商城系统接口规范文档，包含用户端和管理端所有接口",
    "contact": {
      "name": "五金商城开发团队"
    }
